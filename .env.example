# ─────────────────────────────────────────
#  NeuralWatt — Environment Variables
#  Copy this file to .env and fill values
#  Never commit .env to GitHub
# ─────────────────────────────────────────

# MongoDB
MONGODB_URI=mongodb+srv://Neuralwatt:your_password@cluster0.fgofdn1.mongodb.net/neuralwatt?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=neuralwatt

# JWT Authentication
JWT_SECRET_KEY=replace_this_with_a_long_random_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# API Security
# Device keys are generated per household device and sent as X-Device-Key.
# This global key is retained only for older local configs.
DEVICE_API_KEY=

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# CORS — frontend origin
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:3001
